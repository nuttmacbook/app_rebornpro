# ==================================================================== WEBSITE SETTINGS (copy to settings/.env)
# Everything here ends up in the public JavaScript: never put a private key or a secret in this file.
# On Vercel, add each line under Project -> Settings -> Environment Variables.

# Reown (WalletConnect) project id. This one is a shared TEST id: make your own at cloud.reown.com before going live.
VITE_PROJECT_ID=4b2194bd0448ba60db7cf89f36a94c0f

# Network: bsc (BNB Smart Chain) or bscTestnet
VITE_CHAIN=bsc

# Name and words shown on the site and in link previews
VITE_APP_NAME=RebornPro
VITE_APP_TAGLINE=Three slots. Endless rebirth.
VITE_APP_DESCRIPTION=RebornPro runs a 1-to-3 board per package on BNB Smart Chain. Every slot that fills below you pays out at once, and each full board is reborn on its own.

# The real domain of the site, without a slash at the end (for link previews)
VITE_SITE_URL=https://example.com

# production = member and ID numbers are shown as codes; dev = real numbers, with a button to switch
VITE_APP_MODE=production
# Secret-looking text (16+ characters) that turns numbers into codes. NEVER change it after launch:
# every code and every shared link would change.
VITE_ID_KEY=rb-6f1c0e94a7d24b58b3e2

# Maintenance screen. on = every visitor sees "We are updating" instead of the site (the contract keeps running;
# to stop sales too, pause packages on the Owner page). After changing these on Vercel, redeploy the site.
VITE_MAINTENANCE=off
# Optional line on the maintenance screen (empty = the standard sentence)
VITE_MAINTENANCE_MESSAGE=
# Optional word: open the site with ?bypass=<word> to see the real site in that tab during maintenance.
# It is visible in the public JavaScript, so it only hides the site from casual visitors.
VITE_MAINTENANCE_BYPASS=
