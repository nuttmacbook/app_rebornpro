# ==================================================================== LOCAL TEST CHAIN SETTINGS
# Used by npm run dev and npm test. Committed: no secrets here.

# Port of the chain for npm run dev, and a separate one for npm test
LOCAL_PORT=8545
TEST_PORT=8547

# Sample data when npm run dev starts:
#   0      a clean contract: only the root, not launched, no free IDs, no members
#   1      the go-live setup from dev/settings/launch.json, as the owner will do it on the real chain: the owner
#          wallet owns the contract, free IDs under the root, the paid sign-ups in order. Not launched yet.
#   above  the same, then launch, then LOCAL_SEED - 1 random people join. One run only: npm run dev -- --seed 40
LOCAL_SEED=1

# Extra delay per contract read in milliseconds ("min-max"), so the local site feels like a public RPC. 0 = off
LOCAL_RPC_LATENCY=150-450

# What the test panel's buttons give: BNB for gas, and whole tokens of each test token
LOCAL_FUND_GAS=1
LOCAL_FUND_AMOUNT=100

# People created by npm test
TEST_PEOPLE=60
