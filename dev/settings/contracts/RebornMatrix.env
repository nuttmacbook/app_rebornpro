# ==================================================================== SETTINGS OF ONE CONTRACT: RebornMatrix
# deploy.config.mjs reads these as ctx.settings.RebornMatrix.<KEY> and passes them to initialize().
# Every key must have a value. Committed: no secrets here.
# On the local test chain TOKEN_ADDRESS is swapped for a test token (dev/settings/test-tokens.json).

# Token members pay with (USDT on BSC) and its decimals (USDT on BSC: 18)
TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955
TOKEN_DECIMALS=18

# Member #1 (the root, top of every board): its board pay and the referral share of the people it invites.
# Investors placed free have the root as sponsor. Must differ from the three company wallets.
# REPLACE both before a real deploy: these are public hardhat test addresses.
ROOT_WALLET=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
# Company wallets (the company share of every entry is split between them, see the percents below). Also get, in the
# same proportion: the root's own referral share, and money kept on a board that completes without one full price
# (only boards with free IDs). Rounding dust goes to the treasury.
PRODUCT_WALLET=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
MARKETING_WALLET=0x90F79bf6EB2c4f870365E785982E1f101E93b906
TREASURY_WALLET=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65

# Package prices in whole tokens, in upgrade order (10 = 10 USDT). The owner can add more later with addPackage.
PACKAGE_PRICES=10,50,100

# Split of every paid entry, in percent of the package price. For each slot:
# REFERRAL + PRODUCT + MARKETING + TREASURY + SLOT_CASH + SLOT_REBORN must be 100,
# and the three SLOT_REBORN values must add up to 100.
REFERRAL_PERCENT=30
# The company 10%: products, marketing, treasury
PRODUCT_PERCENT=5
MARKETING_PERCENT=2.5
TREASURY_PERCENT=2.5
# Cash to the owner of the board above, for slot 1, 2, 3
SLOT_CASH_PERCENT=60,10,10
# Kept for the board owner's Reborn, for slot 1, 2, 3
SLOT_REBORN_PERCENT=0,50,50

# Placements one register / upgrade / placeFree handles before leaving the rest in the queue
STEPS_PER_TX=25
